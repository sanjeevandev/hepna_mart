# =========================================================================
# HEPNA MART API — BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# =========================================================================
# Copy this file to .env and adjust variables for your local or cloud setup.
# DO NOT commit real secrets or production passwords to version control.

# Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="HEPNA MART API"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY=dev_insecure_secret_key_please_change_in_production_9918237192
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hepna_mart

# CORS Origins (Comma-separated list or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
