<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 300" width="300" height="300">
  <rect width="300" height="300" rx="16" fill="#FFFFFF"/>
  <rect x="20" y="20" width="260" height="260" rx="12" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="2"/>
  
  <!-- Outer Corner Finders -->
  <rect x="40" y="40" width="60" height="60" rx="6" fill="#071A2B"/>
  <rect x="50" y="50" width="40" height="40" rx="4" fill="#FFFFFF"/>
  <rect x="60" y="60" width="20" height="20" rx="2" fill="#E87A2D"/>

  <rect x="200" y="40" width="60" height="60" rx="6" fill="#071A2B"/>
  <rect x="210" y="50" width="40" height="40" rx="4" fill="#FFFFFF"/>
  <rect x="220" y="60" width="20" height="20" rx="2" fill="#E87A2D"/>

  <rect x="40" y="200" width="60" height="60" rx="6" fill="#071A2B"/>
  <rect x="50" y="210" width="40" height="40" rx="4" fill="#FFFFFF"/>
  <rect x="60" y="220" width="20" height="20" rx="2" fill="#E87A2D"/>

  <!-- Simulated QR Pattern Bits -->
  <rect x="120" y="45" width="12" height="12" fill="#071A2B"/>
  <rect x="140" y="45" width="12" height="24" fill="#071A2B"/>
  <rect x="165" y="45" width="12" height="12" fill="#071A2B"/>
  
  <rect x="115" y="70" width="18" height="12" fill="#071A2B"/>
  <rect x="150" y="75" width="12" height="18" fill="#071A2B"/>
  <rect x="175" y="65" width="12" height="12" fill="#071A2B"/>

  <rect x="45" y="115" width="12" height="20" fill="#071A2B"/>
  <rect x="70" y="125" width="20" height="12" fill="#071A2B"/>
  <rect x="45" y="150" width="15" height="15" fill="#071A2B"/>
  <rect x="75" y="160" width="12" height="25" fill="#071A2B"/>

  <rect x="205" y="115" width="20" height="12" fill="#071A2B"/>
  <rect x="235" y="125" width="12" height="20" fill="#071A2B"/>
  <rect x="215" y="150" width="15" height="15" fill="#071A2B"/>
  <rect x="240" y="160" width="12" height="25" fill="#071A2B"/>

  <rect x="120" y="205" width="15" height="15" fill="#071A2B"/>
  <rect x="145" y="215" width="20" height="12" fill="#071A2B"/>
  <rect x="175" y="205" width="15" height="25" fill="#071A2B"/>

  <rect x="115" y="235" width="25" height="12" fill="#071A2B"/>
  <rect x="150" y="240" width="15" height="15" fill="#071A2B"/>
  <rect x="175" y="245" width="20" height="12" fill="#071A2B"/>

  <rect x="215" y="215" width="15" height="15" fill="#071A2B"/>
  <rect x="240" y="205" width="15" height="25" fill="#071A2B"/>
  <rect x="225" y="240" width="25" height="15" fill="#071A2B"/>

  <!-- Center HEPNA MART Logo Badge -->
  <rect x="105" y="105" width="90" height="90" rx="10" fill="#071A2B" stroke="#E87A2D" stroke-width="3"/>
  <text x="150" y="145" font-family="sans-serif" font-size="14" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="1">HEPNA</text>
  <text x="150" y="165" font-family="sans-serif" font-size="11" font-weight="700" fill="#E87A2D" text-anchor="middle" letter-spacing="2">MART</text>
  <text x="150" y="180" font-family="sans-serif" font-size="8" font-weight="600" fill="#94A3B8" text-anchor="middle">UPI PAY</text>
</svg>
